{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/tests/version-test.py\" --hook-stdin 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking version sync"
          }
        ]
      }
    ]
  }
}
